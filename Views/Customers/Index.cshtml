@model IEnumerable<abc.Models.CustomerEntity>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Customers</h2>
<p>
    <a class="btn btn-primary" href="/Customers/Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>CustomerId</th>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Address</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach(var c in Model) {
        <tr>
            <td>@c.CustomerId</td>
            <td>@(c.FirstName) @c.LastName</td>
            <td>@c.Email</td>
            <td>@c.Phone</td>
            <td>@c.Address</td>
            <td>
                <a class="btn btn-sm btn-secondary" href="/Customers/Edit/@c.CustomerId">Edit</a>
                <a class="btn btn-sm btn-danger" href="/Customers/Delete/@c.CustomerId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
